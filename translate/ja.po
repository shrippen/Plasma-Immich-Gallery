msgstr "最近"

msgid "Favorites"
msgstr "お気に入り"

msgid "Random"
msgstr "ランダム"

msgid "Album"
msgstr "アルバム"

msgid "People"
msgstr "人物"

msgid "Albums:"
msgstr "アルバム："

msgid "No albums selected"
msgstr "アルバムが選択されていません"

msgid "1 album"
msgstr "1 アルバム"

msgid "%1 albums selected"
msgstr "%1 アルバム選択中"

msgid "Load"
msgstr "読み込み"

msgid "Unnamed Album"
msgstr "名のないアルバム"

msgid "People:"
msgstr "人物："

msgid "No people selected"
msgstr "人物が選択されていません"

msgid "1 person"
msgstr "1 人"

msgid "%1 people selected"
msgstr "%1 人選択中"

msgid "Border:"
msgstr "ボーダー："

msgid "Remove widget border and background"
msgstr "ウィジェットのボーダーと背景を削除"

msgid "Opacity:"
msgstr "不透明度："

msgid "Immich Gallery\n\nRight-click → Configure to get started."
msgstr "Immich ギャラリー\n\n右クリック → 設定して開始。"

msgid "No photos found for this source."
msgstr "このソースの写真が見つかりません。"

msgid "No album selected. Go to Configure → Display."
msgstr "アルバムが選択されていません。設定 → 表示に移動。"

msgid "No person selected. Go to Configure → Display."
msgstr "人物が選択されていません。設定 → 表示に移動。"

msgid "Hour of day (0–23) when the daily photo changes. Default is 0 (midnight)."
msgstr "今日の写真が変わる時刻（0–23）。デフォルトは 0（深夜）。"

msgid "How often to re-fetch the photo list from your Immich server. Does not affect the slideshow speed."
msgstr "Immich サーバーから写真リストを再取得する頻度。スライドショーの速度には影響しません。"

msgid "Generate an API key in the Immich web interface:"
msgstr "Immich ウェブインターフェースで API キーを生成してください："

msgid "Account Settings → API Keys → New API Key"
msgstr "アカウント設定 → API キー → 新しい API キー"

msgid "Required API key permissions:"
msgstr "必要な API キーの権限："

msgid "• Album — Read  (%1)"
msgstr "• アルバム — 読み取り  (%1)"

msgid "Album source"
msgstr "アルバムソース"

msgid "• Person — Read  (%1)"
msgstr "• 人物 — 読み取り  (%1)"

msgid "People source"
msgstr "人物ソース"
